# ==============================================================================
# RENDER BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env for local development or set variables in Render Dashboard
# ==============================================================================

# Server Environment & Port
NODE_ENV=production
PORT=5000
CLIENT_URL=https://your-frontend.vercel.app

# JWT Authentication Secret (Generate a strong random string)
JWT_SECRET=your_jwt_secret_here_min_32_characters
JWT_EXPIRES_IN=7d

# Production MySQL Database Configuration (Aiven / PlanetScale / AWS RDS / TiDB Cloud / etc.)
DB_HOST=your-mysql-host.example.com
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=travel_booking_db
DB_CONNECTION_LIMIT=10
DB_SSL=true

# Alternative Single MySQL Connection URL (if provided by your database host)
# DATABASE_URL=mysql://user:password@host:port/database?ssl={"rejectUnauthorized":false}

# Google Gemini AI Integration (Backend AI Travel Agent & Chatbot)
GEMINI_API_KEY=your_gemini_api_key_here

# Razorpay Payment Gateway Integration (Test or Live Keys)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key

# Optional Google OAuth 2.0 (if Google Sign-In is used)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://your-backend.onrender.com/api/auth/google/callback

# Optional Weather API
WEATHER_API_KEY=
