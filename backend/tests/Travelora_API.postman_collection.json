{
  "info": {
    "_postman_id": "8f3d1b2a-7e4a-4d2c-9a1b-3f6e8a2d4c5e",
    "name": "Travelora API Collection (v2.1)",
    "description": "Comprehensive Postman API testing suite for Travelora Travel Planning & Booking Platform covering all 13 core modules, AI capabilities, and administrative RBAC.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Health & Docs",
      "item": [
        {
          "name": "System Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Authentication",
      "item": [
        {
          "name": "User Registration",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Alex Morgan\",\n  \"email\": \"alex.test@example.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "User Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set('authToken', jsonData.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Destinations",
      "item": [
        {
          "name": "List Destinations",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/destinations?category=all&sortBy=popularity",
              "host": ["{{baseUrl}}"],
              "path": ["destinations"],
              "query": [
                { "key": "category", "value": "all" },
                { "key": "sortBy", "value": "popularity" }
              ]
            }
          }
        },
        {
          "name": "Search Destinations",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/destinations/search?q=Bali",
              "host": ["{{baseUrl}}"],
              "path": ["destinations", "search"],
              "query": [{ "key": "q", "value": "Bali" }]
            }
          }
        }
      ]
    },
    {
      "name": "4. Packages",
      "item": [
        {
          "name": "List Packages",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/packages",
              "host": ["{{baseUrl}}"],
              "path": ["packages"]
            }
          }
        },
        {
          "name": "Get Package by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/packages/1",
              "host": ["{{baseUrl}}"],
              "path": ["packages", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "5. Bookings & Payments",
      "item": [
        {
          "name": "Create Booking",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"packageId\": 1,\n  \"destinationId\": 1,\n  \"travelDate\": \"2026-11-15\",\n  \"travelersCount\": 2,\n  \"totalAmount\": 2198.00,\n  \"primaryTravelerName\": \"John Doe\",\n  \"primaryTravelerEmail\": \"john@example.com\",\n  \"primaryTravelerPhone\": \"+1-555-0199\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/bookings",
              "host": ["{{baseUrl}}"],
              "path": ["bookings"]
            }
          }
        },
        {
          "name": "Process Payment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookingId\": 1,\n  \"amount\": 2198.00,\n  \"paymentMethod\": \"credit_card\",\n  \"cardNumber\": \"4111222233334444\",\n  \"simulateDecline\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/payments/process",
              "host": ["{{baseUrl}}"],
              "path": ["payments", "process"]
            }
          }
        }
      ]
    },
    {
      "name": "6. Reviews & Ratings",
      "item": [
        {
          "name": "Get Destination Reviews & Aggregates",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/reviews?destinationId=1",
              "host": ["{{baseUrl}}"],
              "path": ["reviews"],
              "query": [{ "key": "destinationId", "value": "1" }]
            }
          }
        },
        {
          "name": "Submit Verified Review",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"destinationId\": 1,\n  \"rating\": 5,\n  \"title\": \"Unforgettable Island Vacation\",\n  \"comment\": \"Breathtaking sunsets and immaculate resort service!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/reviews",
              "host": ["{{baseUrl}}"],
              "path": ["reviews"]
            }
          }
        }
      ]
    },
    {
      "name": "7. AI Recommendations & Smart Itinerary",
      "item": [
        {
          "name": "Generate AI Recommendations",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"budget\": 20000,\n  \"currency\": \"INR\",\n  \"durationDays\": 4,\n  \"interest\": \"beach\",\n  \"travelType\": \"family\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/recommendations",
              "host": ["{{baseUrl}}"],
              "path": ["recommendations"]
            }
          }
        },
        {
          "name": "Generate AI Smart Day-by-Day Itinerary",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"destination\": \"Goa Coastal Haven\",\n  \"numberOfDays\": 4,\n  \"budget\": 20000,\n  \"currency\": \"INR\",\n  \"travelType\": \"family\",\n  \"interests\": [\"beach\", \"seafood\", \"relaxation\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/trips/generate-ai-itinerary",
              "host": ["{{baseUrl}}"],
              "path": ["trips", "generate-ai-itinerary"]
            }
          }
        },
        {
          "name": "AI Travel Chatbot Question",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"What is the best time to visit Bali on a budget?\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/chatbot/message",
              "host": ["{{baseUrl}}"],
              "path": ["chatbot", "message"]
            }
          }
        }
      ]
    },
    {
      "name": "8. Admin & RBAC",
      "item": [
        {
          "name": "Admin Platform Stats",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/stats",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "stats"]
            }
          }
        }
      ]
    }
  ]
}
